@{
    // Con sesión (gestionar cuenta): el layout del sistema. Sin sesión (acceso, registro): la página pública, sin la navegación interna.
    var conSesion = User.Identity?.IsAuthenticated == true;
    Layout = conSesion ? "/Views/Shared/_Layout.cshtml" : "/Views/Shared/_LayoutPublico.cshtml";
}

@if (conSesion)
{
    @RenderBody()
}
else
{
    <div class="acceso">
        <div class="acceso-tarjeta">
            @RenderBody()
        </div>
    </div>
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
