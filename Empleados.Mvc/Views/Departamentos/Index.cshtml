@model IEnumerable<Departamento>
@{
    ViewData["Title"] = "Departamentos";
}

<div style="max-width:1100px; margin:0 auto;">
    <div style="display:flex; align-items:flex-start; justify-content:space-between; gap: var(--space-md); margin-bottom: var(--space-lg); flex-wrap:wrap;">
        <div style="display:flex; gap: var(--space-md); align-items:flex-start;">
            <span style="width:44px; height:44px; display:grid; place-items:center; background: var(--bg-surface); border:1px solid var(--border-color); border-radius: var(--radius); color: var(--text-secondary);"><i class="bi bi-building" style="font-size:1.2rem;"></i></span>
            <div>
                <h1 style="font-size:1.35rem; font-weight:700; margin:0; letter-spacing:-0.02em;">Departamentos</h1>
                <p style="margin:0.2rem 0 0; color: var(--text-secondary); font-size:0.9rem;">Estructura organizativa · @Model.Count() departamentos</p>
            </div>
        </div>
        <a asp-action="Create" style="display:inline-flex; align-items:center; gap:0.5rem; background: var(--text-primary); color: var(--bg-surface); border:1px solid var(--text-primary); border-radius: var(--radius); padding:0.55rem 0.9rem; font-weight:500; text-decoration:none; font-size:0.9rem;">
            <i class="bi bi-plus-lg"></i> Nuevo departamento
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background: var(--success-soft); border:1px solid var(--success-border); color: var(--success); border-radius: var(--radius); padding:0.75rem 1rem; display:flex; align-items:center; gap:0.5rem; margin-bottom: var(--space-md);">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background: var(--danger-soft); border:1px solid var(--danger-border); color: var(--danger); border-radius: var(--radius); padding:0.75rem 1rem; display:flex; align-items:center; gap:0.5rem; margin-bottom: var(--space-md);">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    @if (!Model.Any())
    {
        <partial name="~/Views/Shared/Components/_EmptyState.cshtml" model='((string Icon, string Title, string Description, string ActionText, string? ActionUrl)) ("bi-building", "Sin departamentos", "Crea el primer departamento para organizar empleados y puestos.", "Nuevo departamento", Url.Action("Create") ?? "")' />
    }
    else
    {
        <div style="background: var(--bg-surface); border:1px solid var(--border-color); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow:hidden;">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: var(--bg-muted);">
                        <tr>
                            <th style="padding:0.75rem 1rem; font-size:0.75rem; letter-spacing:0.05em; text-transform:uppercase; color: var(--text-muted); font-weight:600; border-bottom:1px solid var(--border-color); width:60px;">ID</th>
                            <th style="padding:0.75rem 1rem; font-size:0.75rem; letter-spacing:0.05em; text-transform:uppercase; color: var(--text-muted); font-weight:600; border-bottom:1px solid var(--border-color);">Nombre</th>
                            <th style="padding:0.75rem 1rem; font-size:0.75rem; letter-spacing:0.05em; text-transform:uppercase; color: var(--text-muted); font-weight:600; border-bottom:1px solid var(--border-color);">Descripción</th>
                            <th style="padding:0.75rem 1rem; font-size:0.75rem; letter-spacing:0.05em; text-transform:uppercase; color: var(--text-muted); font-weight:600; border-bottom:1px solid var(--border-color); text-align:center;">Empleados</th>
                            <th style="padding:0.75rem 1rem; font-size:0.75rem; letter-spacing:0.05em; text-transform:uppercase; color: var(--text-muted); font-weight:600; border-bottom:1px solid var(--border-color); text-align:right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr style="border-bottom:1px solid var(--border-color);">
                                <td style="padding:0.85rem 1rem; color: var(--text-muted); font-size:0.85rem; font-weight:500;">#@item.Id</td>
                                <td style="padding:0.85rem 1rem;">
                                    <div style="display:flex; align-items:center; gap:0.6rem;">
                                        <span style="width:32px; height:32px; border-radius: var(--radius); background: var(--bg-muted); border:1px solid var(--border-color); display:grid; place-items:center; color: var(--text-secondary);"><i class="bi bi-building" style="font-size:0.9rem;"></i></span>
                                        <span style="font-weight:600; color: var(--text-primary); font-size:0.9rem;">@item.Nombre</span>
                                    </div>
                                </td>
                                <td style="padding:0.85rem 1rem; color: var(--text-secondary); font-size:0.9rem; max-width:320px;">@(string.IsNullOrWhiteSpace(item.Descripcion) ? "—" : item.Descripcion)</td>
                                <td style="padding:0.85rem 1rem; text-align:center;"><span style="display:inline-flex; min-width:32px; justify-content:center; padding:0.25rem 0.6rem; border-radius: var(--radius-pill); background: var(--bg-muted); border:1px solid var(--border-color); color: var(--text-secondary); font-size:0.8rem; font-weight:600;">@item.Empleados.Count</span></td>
                                <td style="padding:0.85rem 1rem; text-align:right;">
                                    <div style="display:inline-flex; gap:0.35rem;">
                                        <a asp-action="Edit" asp-route-id="@item.Id" title="Editar" style="width:32px; height:32px; display:grid; place-items:center; border-radius: var(--radius); border:1px solid var(--border-color); background: var(--bg-surface); color: var(--text-secondary); text-decoration:none;"><i class="bi bi-pencil" style="font-size:0.85rem;"></i></a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline">
                                            <button type="submit" title="Eliminar" onclick="return confirm('¿Eliminar este departamento?')" style="width:32px; height:32px; display:grid; place-items:center; border-radius: var(--radius); border:1px solid var(--danger-border); background: var(--danger-soft); color: var(--danger); cursor:pointer;"><i class="bi bi-trash" style="font-size:0.85rem;"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
