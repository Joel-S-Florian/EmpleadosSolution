@model CrearEmpleadoDto
@{
    ViewData["Title"] = "Nuevo empleado";
}

<div class="app-pagina">
    <div class="app-encabezado">
        <div class="d-flex gap-3 align-items-start">
            <a asp-action="Index" class="app-icono" aria-label="Volver"><i class="bi bi-arrow-left"></i></a>
            <div>
                <h1>Nuevo empleado</h1>
                <p>Complete los datos por apartado; puede terminar los de seguridad social después.</p>
            </div>
        </div>
    </div>

    <form asp-action="Create" class="app-form-empleado">
        <partial name="_FormEmpleado" model="Model" />
        <div class="app-barra-acciones">
            <span class="app-ayuda">Los campos con * son obligatorios</span>
            <a asp-action="Index" class="app-boton-sec">Cancelar</a>
            <button type="submit" class="app-boton"><i class="bi bi-check-lg"></i> Guardar empleado</button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/empleado-form.js" asp-append-version="true"></script>
}
