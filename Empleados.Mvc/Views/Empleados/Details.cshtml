@model Empleado
@using Empleados.Data.Entities
@{
    ViewData["Title"] = "Detalle del empleado";
}

<div style="max-width:900px; margin:0 auto;">
    <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom: var(--space-lg);">
        <a asp-action="Index" style="width:36px; height:36px; display:grid; place-items:center; border-radius: var(--radius); border:1px solid var(--border-color); background: var(--bg-surface); color: var(--text-secondary); text-decoration:none;"><i class="bi bi-arrow-left"></i></a>
        <div>
            <h1 style="font-size:1.25rem; font-weight:700; margin:0; letter-spacing:-0.02em;">@Model.Nombre @Model.Apellido</h1>
            <p style="margin:0; color: var(--text-secondary); font-size:0.9rem;">@Model.CorreoElectronico · @(Model.Departamento?.Nombre ?? "Sin departamento")</p>
        </div>
        <div style="margin-left:auto; display:flex; gap:0.5rem;">
            <partial name="~/Views/Shared/Components/_BadgeEstado.cshtml" model="Model.Estado" />
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div style="background: var(--success-soft); border:1px solid var(--success-border); color: var(--success); border-radius: var(--radius); padding:0.75rem 1rem; display:flex; align-items:center; gap:0.5rem; margin-bottom: var(--space-md);">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div style="background: var(--danger-soft); border:1px solid var(--danger-border); color: var(--danger); border-radius: var(--radius); padding:0.75rem 1rem; display:flex; align-items:center; gap:0.5rem; margin-bottom: var(--space-md);">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }

    <div style="display:grid; grid-template-columns: 1fr 320px; gap: var(--space-lg); align-items:start;">
        <div style="background: var(--bg-surface); border:1px solid var(--border-color); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow:hidden;">
            <div style="padding: var(--space-lg) var(--space-xl); border-bottom:1px solid var(--border-color); display:flex; align-items:center; gap:0.75rem;">
                <span style="width:36px; height:36px; display:grid; place-items:center; background: var(--bg-muted); border:1px solid var(--border-color); border-radius: var(--radius); color: var(--text-secondary);"><i class="bi bi-person-vcard"></i></span>
                <div>
                    <div style="font-weight:600; color: var(--text-primary);">Información</div>
                    <div style="font-size:0.8rem; color: var(--text-muted);">Datos personales y laborales</div>
                </div>
            </div>
            <div style="padding: var(--space-xl); display:grid; gap: var(--space-md);">
                @{
                    void Row(string label, string value) {
                        <div style="display:grid; grid-template-columns: 160px 1fr; gap: var(--space-md); padding:0.6rem 0; border-bottom:1px solid var(--border-color); align-items:center;">
                            <span style="font-size:0.8rem; font-weight:600; color: var(--text-muted); letter-spacing:0.02em;">@label</span>
                            <span style="font-size:0.9rem; color: var(--text-primary); font-weight:500;">@value</span>
                        </div>
                    }
                }
                @{ Row("Nombre completo", $"{Model.Nombre} {Model.Apellido}"); }
                @{ Row("Fecha nacimiento", Model.FechaNacimiento.ToString("dd/MM/yyyy")); }
                @{ Row("Dirección", Model.Direccion); }
                @{ Row("Teléfono", Model.Telefono); }
                @{ Row("Correo", Model.CorreoElectronico); }
                @{ Row("Puesto", string.IsNullOrWhiteSpace(Model.Puesto) ? "—" : Model.Puesto); }
                @{ Row("Puesto vinculado", Model.PuestoNav?.Nombre ?? "—"); }
                @{ Row("Salario", Model.Salario.ToString("C", new System.Globalization.CultureInfo("es-DO"))); }
                @{ Row("Contratación", Model.FechaContratacion.ToString("dd/MM/yyyy")); }
                @{ Row("Terminación", Model.FechaTerminacion?.ToString("dd/MM/yyyy") ?? "—"); }
                @{ Row("Departamento", Model.Departamento?.Nombre ?? "—"); }
            </div>
            <div style="padding: var(--space-lg) var(--space-xl); border-top:1px solid var(--border-color); background: var(--bg-muted); display:flex; gap:0.5rem; flex-wrap:wrap;">
                <a asp-action="Index" style="display:inline-flex; align-items:center; gap:0.4rem; background: var(--bg-surface); color: var(--text-primary); border:1px solid var(--border-color); border-radius: var(--radius); padding:0.5rem 0.9rem; font-weight:500; text-decoration:none;"><i class="bi bi-arrow-left"></i> Volver</a>
                @if (User.IsInRole("Admin") && Model.Estado != EstadoEmpleado.Despedido)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" style="display:inline-flex; align-items:center; gap:0.4rem; background: var(--text-primary); color: var(--bg-surface); border:1px solid var(--text-primary); border-radius: var(--radius); padding:0.5rem 0.9rem; font-weight:500; text-decoration:none;"><i class="bi bi-pencil"></i> Editar</a>
                }
            </div>
        </div>

        <div style="display:flex; flex-direction:column; gap: var(--space-lg);">
            <div style="background: var(--bg-surface); border:1px solid var(--border-color); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); overflow:hidden; text-align:center; padding: var(--space-xl);">
                @if (!string.IsNullOrEmpty(Model.FotoRuta))
                {
                    <img src="@Model.FotoRuta" alt="Foto de @Model.Nombre" style="width:160px; height:160px; object-fit:cover; border-radius: var(--radius-lg); border:1px solid var(--border-color); box-shadow: var(--shadow-sm);" />
                }
                else
                {
                    <div style="width:160px; height:160px; border-radius: var(--radius-lg); background: var(--bg-muted); border:1px solid var(--border-color); display:grid; place-items:center; margin:0 auto; color: var(--text-muted);">
                        <i class="bi bi-person" style="font-size:3rem;"></i>
                    </div>
                    <div style="margin-top: var(--space-sm); color: var(--text-muted); font-size:0.85rem;">Sin foto</div>
                }
                @if (User.IsInRole("Admin") && Model.Estado != EstadoEmpleado.Despedido)
                {
                    <hr style="border-color: var(--border-color); margin: var(--space-lg) 0;" />
                    <form asp-action="SubirFoto" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" style="text-align:left;">
                        <label style="font-size:0.8rem; font-weight:600; color: var(--text-secondary); letter-spacing:0.02em; margin-bottom:0.35rem; display:block;">Subir foto</label>
                        <input type="file" name="foto" class="form-control" accept="image/*" required style="background: var(--bg-surface); border:1px solid var(--border-color); border-radius: var(--radius); padding:0.4rem; font-size:0.85rem;" />
                        <button type="submit" style="margin-top:0.6rem; width:100%; display:inline-flex; align-items:center; justify-content:center; gap:0.4rem; background: var(--bg-surface); color: var(--text-primary); border:1px solid var(--border-color); border-radius: var(--radius); padding:0.5rem; font-weight:500; cursor:pointer;">
                            <i class="bi bi-cloud-upload"></i> Subir
                        </button>
                    </form>
                }
            </div>

            <div style="background: var(--bg-surface); border:1px solid var(--border-color); border-radius: var(--radius); padding: var(--space-lg); box-shadow: var(--shadow-sm);">
                <div style="font-size:0.8rem; font-weight:600; color: var(--text-muted); letter-spacing:0.05em; text-transform:uppercase; margin-bottom: var(--space-sm);">Estado</div>
                <div style="display:flex; align-items:center; gap:0.6rem;">
                    <partial name="~/Views/Shared/Components/_BadgeEstado.cshtml" model="Model.Estado" />
                    @if (Model.FechaTerminacion.HasValue)
                    {
                        <span style="font-size:0.8rem; color: var(--text-muted);">desde @Model.FechaTerminacion.Value.ToString("dd/MM/yyyy")</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
