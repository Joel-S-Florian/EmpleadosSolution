@model ActualizarEmpleadoDto
@{
    ViewData["Title"] = "Editar empleado";
}

<div class="app-pagina">
    <div class="app-encabezado">
        <div class="d-flex gap-3 align-items-start">
            <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="app-icono" aria-label="Volver"><i class="bi bi-arrow-left"></i></a>
            <div>
                <h1>Editar empleado</h1>
                <p>@Model.Nombre @Model.Apellido · @Model.CorreoElectronico</p>
            </div>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" class="app-form-empleado">
        <partial name="_FormEmpleado" model="Model" />
        <div class="app-barra-acciones">
            <span class="app-ayuda">Los campos con * son obligatorios</span>
            <a asp-action="Details" asp-route-id="@ViewContext.RouteData.Values["id"]" class="app-boton-sec">Cancelar</a>
            <button type="submit" class="app-boton"><i class="bi bi-check-lg"></i> Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/empleado-form.js" asp-append-version="true"></script>
}
