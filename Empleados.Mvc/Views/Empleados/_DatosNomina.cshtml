@model CrearEmpleadoDto
@* Datos de nómina, TSS y banco; compartido por Create y Edit *@

<div class="mt-4 pt-3 border-top">
    <div class="fw-semibold mb-1"><i class="bi bi-cash-stack"></i> Datos de nómina</div>
    <div class="app-ayuda mb-3">Documento y NSS serán obligatorios para calcular la nómina; puede completarlos después.</div>
    <div class="row g-3">
        <div class="col-md-3">
            <label asp-for="TipoDocumento" class="app-etiqueta">Documento</label>
            <select asp-for="TipoDocumento" asp-items="Html.GetEnumSelectList<TipoDocumento>()" class="form-select"></select>
        </div>
        <div class="col-md-3">
            <label asp-for="NumeroDocumento" class="app-etiqueta">Número</label>
            <input asp-for="NumeroDocumento" class="form-control" placeholder="001-0000000-0" />
            <span asp-validation-for="NumeroDocumento" class="app-error"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Nss" class="app-etiqueta">NSS</label>
            <input asp-for="Nss" class="form-control" placeholder="Número de seguridad social" />
            <span asp-validation-for="Nss" class="app-error"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="Sexo" class="app-etiqueta">Sexo</label>
            <select asp-for="Sexo" asp-items="Html.GetEnumSelectList<Sexo>()" class="form-select">
                <option value="">—</option>
            </select>
        </div>
        <div class="col-md-4">
            <label asp-for="Afp" class="app-etiqueta">AFP</label>
            <input asp-for="Afp" class="form-control" placeholder="Ej: AFP Popular" />
        </div>
        <div class="col-md-4">
            <label asp-for="Ars" class="app-etiqueta">ARS</label>
            <input asp-for="Ars" class="form-control" placeholder="Ej: ARS Humano" />
        </div>
        <div class="col-md-4">
            <label asp-for="DependientesSfs" class="app-etiqueta">Dependientes adicionales SFS</label>
            <input asp-for="DependientesSfs" type="number" min="0" max="20" class="form-control" />
            <span asp-validation-for="DependientesSfs" class="app-error"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="TipoContrato" class="app-etiqueta">Tipo de contrato</label>
            <select asp-for="TipoContrato" asp-items="Html.GetEnumSelectList<TipoContrato>()" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="FechaFinContrato" class="app-etiqueta">Fin del contrato</label>
            <input asp-for="FechaFinContrato" type="date" class="form-control" />
            <span asp-validation-for="FechaFinContrato" class="app-error"></span>
            <div class="app-ayuda">Obligatoria si es por tiempo definido</div>
        </div>
        <div class="col-md-2">
            <label asp-for="FrecuenciaPago" class="app-etiqueta">Frecuencia</label>
            <select asp-for="FrecuenciaPago" asp-items="Html.GetEnumSelectList<FrecuenciaPago>()" class="form-select">
                <option value="">La de la empresa</option>
            </select>
        </div>
        <div class="col-md-2">
            <label asp-for="TipoSalario" class="app-etiqueta">Tipo de salario</label>
            <select asp-for="TipoSalario" asp-items="Html.GetEnumSelectList<TipoSalario>()" class="form-select"></select>
            <div class="app-ayuda">Por hora: el salario es la tarifa</div>
        </div>
        <div class="col-md-5">
            <label asp-for="BancoId" class="app-etiqueta">Banco</label>
            <select data-smart-select asp-for="BancoId" asp-items="ViewBag.Bancos" class="form-select">
                <option value="">Sin cuenta (pago por cheque o efectivo)</option>
            </select>
            <span asp-validation-for="BancoId" class="app-error"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="NumeroCuenta" class="app-etiqueta">Número de cuenta</label>
            <input asp-for="NumeroCuenta" class="form-control" />
            <span asp-validation-for="NumeroCuenta" class="app-error"></span>
        </div>
        <div class="col-md-3">
            <label asp-for="TipoCuenta" class="app-etiqueta">Tipo de cuenta</label>
            <select asp-for="TipoCuenta" asp-items="Html.GetEnumSelectList<TipoCuenta>()" class="form-select">
                <option value="">—</option>
            </select>
        </div>
    </div>
</div>
