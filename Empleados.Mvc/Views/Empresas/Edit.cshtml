@model EmpresaDto
@{
    ViewData["Title"] = "Editar empresa";
    var asignados = (HashSet<string>)ViewBag.Asignados;
    var ultima = (NominaPeriodo?)ViewBag.UltimaNomina;
    var usuarios = ((IEnumerable<dynamic>)ViewBag.Usuarios).ToList();
}

<div class="app-pagina">
    <div class="app-encabezado">
        <div class="d-flex gap-3 align-items-start">
            <a asp-action="Index" class="app-icono" aria-label="Volver"><i class="bi bi-arrow-left"></i></a>
            <div>
                <h1>@Model.RazonSocial @if (!Model.Activa) { <span class="app-chip">Inactiva</span> }</h1>
                <p>RNC @Model.Rnc@(string.IsNullOrWhiteSpace(Model.NombreComercial) ? "" : " · " + Model.NombreComercial)</p>
            </div>
        </div>
    </div>

    <partial name="~/Views/Shared/Components/_Alertas.cshtml" />

    <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]">
        <div class="row g-3">
            <div class="col-lg-8">
                <partial name="_FormEmpresa" model="Model" />
            </div>

            <div class="col-lg-4">
                <div class="app-tarjeta">
                    <div class="app-tarjeta-titulo"><i class="bi bi-info-circle"></i> Resumen</div>
                    <div class="app-tarjeta-cuerpo">
                        <dl class="app-datos">
                            <dt>Empleados activos</dt><dd>@ViewBag.EmpleadosActivos</dd>
                            <dt>Departamentos</dt><dd>@ViewBag.Departamentos</dd>
                            <dt>Con acceso al portal</dt><dd>@ViewBag.EmpleadosPortal</dd>
                            <dt>Última nómina pagada</dt>
                            <dd>@(ultima == null ? "—" : $"{ultima.Descripcion} · {ultima.FechaPago:dd/MM/yyyy}")</dd>
                        </dl>
                    </div>
                </div>

                <div class="app-tarjeta">
                    <div class="app-tarjeta-titulo"><i class="bi bi-people"></i> Usuarios con acceso</div>
                    <div class="app-tarjeta-cuerpo">
                        <p class="app-ayuda">Solo verán los datos de las empresas marcadas. El acceso de los empleados al portal se da desde su ficha.</p>
                        @if (usuarios.Count > 6)
                        {
                            <input type="search" class="form-control form-control-sm mb-2" placeholder="Buscar usuario…" aria-label="Buscar usuario"
                                   oninput="const q=this.value.toLowerCase(); document.querySelectorAll('[data-usuario]').forEach(el => el.hidden = !el.dataset.usuario.includes(q));" />
                        }
                        <div class="app-lista-usuarios">
                            @foreach (var usuario in usuarios)
                            {
                                <div class="form-check" data-usuario="@(((string)usuario.Email).ToLowerInvariant())">
                                    <input class="form-check-input" type="checkbox" name="usuarioIds" value="@usuario.Id" id="u-@usuario.Id" checked="@asignados.Contains((string)usuario.Id)" />
                                    <label class="form-check-label" for="u-@usuario.Id">@usuario.Email</label>
                                </div>
                            }
                        </div>
                        <div class="app-ayuda mt-2">@usuarios.Count(u => asignados.Contains((string)u.Id)) de @usuarios.Count con acceso</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-barra-acciones">
            <a asp-action="Index" class="app-boton-sec">Cancelar</a>
            <button type="submit" class="app-boton"><i class="bi bi-check-lg"></i> Guardar cambios</button>
        </div>
    </form>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
