@model EmpresaDto
@* Datos de la empresa por apartados; compartido por Create y Edit *@

<div asp-validation-summary="ModelOnly" class="app-resumen-error"></div>

<section class="app-tarjeta">
    <div class="app-tarjeta-titulo"><i class="bi bi-building"></i> Identificación</div>
    <div class="app-tarjeta-cuerpo row g-3">
        <div class="col-md-4">
            <label asp-for="Rnc" class="app-etiqueta">RNC *</label>
            <input asp-for="Rnc" class="form-control" placeholder="9 u 11 dígitos" />
            <span asp-validation-for="Rnc" class="app-error"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="RazonSocial" class="app-etiqueta">Razón social *</label>
            <input asp-for="RazonSocial" class="form-control" />
            <span asp-validation-for="RazonSocial" class="app-error"></span>
        </div>
        <div class="col-md-8">
            <label asp-for="NombreComercial" class="app-etiqueta">Nombre comercial</label>
            <input asp-for="NombreComercial" class="form-control" />
            <span asp-validation-for="NombreComercial" class="app-error"></span>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check form-switch mb-2">
                <input asp-for="Activa" class="form-check-input" role="switch" />
                <label asp-for="Activa" class="form-check-label">Empresa activa</label>
            </div>
        </div>
    </div>
</section>

<section class="app-tarjeta">
    <div class="app-tarjeta-titulo"><i class="bi bi-cash-stack"></i> Nómina y obligaciones <small>afectan los cálculos</small></div>
    <div class="app-tarjeta-cuerpo row g-3">
        <div class="col-md-6">
            <label asp-for="Tamano" class="app-etiqueta">Tamaño *</label>
            <select asp-for="Tamano" asp-items="Html.GetEnumSelectList<TamanoEmpresa>()" class="form-select"></select>
            <div class="app-ayuda">Define el salario mínimo aplicable</div>
        </div>
        <div class="col-md-6">
            <label asp-for="FrecuenciaPagoPredeterminada" class="app-etiqueta">Frecuencia de pago *</label>
            <select asp-for="FrecuenciaPagoPredeterminada" asp-items="Html.GetEnumSelectList<FrecuenciaPago>()" class="form-select"></select>
            <div class="app-ayuda">La que reciben los empleados nuevos</div>
        </div>
        <div class="col-md-6">
            <label asp-for="TasaRiesgoSrl" class="app-etiqueta">Tasa de riesgos laborales (%) *</label>
            <input asp-for="TasaRiesgoSrl" type="number" step="0.01" min="0" max="10" class="form-control" />
            <span asp-validation-for="TasaRiesgoSrl" class="app-error"></span>
            <div class="app-ayuda">La que asigna la TSS (entre 1.10 y 1.30 aprox.)</div>
        </div>
        <div class="col-md-6">
            <label asp-for="MesCierreFiscal" class="app-etiqueta">Mes de cierre fiscal *</label>
            <select asp-for="MesCierreFiscal" class="form-select">
                @for (var m = 1; m <= 12; m++)
                {
                    <option value="@m">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                }
            </select>
            <span asp-validation-for="MesCierreFiscal" class="app-error"></span>
            <div class="app-ayuda">Para la bonificación (art. 223)</div>
        </div>
    </div>
</section>

<section class="app-tarjeta">
    <div class="app-tarjeta-titulo"><i class="bi bi-geo-alt"></i> Contacto</div>
    <div class="app-tarjeta-cuerpo row g-3">
        <div class="col-md-7">
            <label asp-for="CorreoElectronico" class="app-etiqueta">Correo</label>
            <input asp-for="CorreoElectronico" class="form-control" />
            <span asp-validation-for="CorreoElectronico" class="app-error"></span>
        </div>
        <div class="col-md-5">
            <label asp-for="Telefono" class="app-etiqueta">Teléfono</label>
            <input asp-for="Telefono" class="form-control" />
        </div>
        <div class="col-12">
            <label asp-for="Direccion" class="app-etiqueta">Dirección</label>
            <input asp-for="Direccion" class="form-control" />
            <div class="app-ayuda">Sale en la carta de trabajo</div>
        </div>
    </div>
</section>
