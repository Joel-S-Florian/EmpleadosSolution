@model ResumenInicio
@{
    ViewData["Title"] = "Inicio";
    var gestiona = User.IsInRole("Admin") || User.IsInRole("RRHH");
}

<div class="app-pagina">
    <div class="app-encabezado">
        <div class="d-flex gap-3 align-items-start">
            <span class="app-icono"><i class="bi bi-house"></i></span>
            <div>
                <h1>Inicio</h1>
                <p>Lo pendiente de la empresa, @DateTime.Today.ToString("dddd d 'de' MMMM")</p>
            </div>
        </div>
        @if (gestiona)
        {
            <div class="d-flex gap-2 flex-wrap">
                <a asp-controller="Nominas" asp-action="Index" class="app-boton"><i class="bi bi-cash-stack"></i> Nóminas</a>
                <a asp-controller="Incidencias" asp-action="Index" class="app-boton-sec"><i class="bi bi-calendar2-check"></i> Incidencias</a>
            </div>
        }
    </div>

    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <a asp-controller="Empleados" asp-action="Index" class="app-tarjeta d-block text-decoration-none h-100">
                <div class="app-tarjeta-cuerpo"><span class="app-ayuda d-block">Empleados activos</span><span class="fs-3 fw-bold" style="color: var(--text-primary);">@Model.EmpleadosActivos</span></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-controller="Nominas" asp-action="Index" class="app-tarjeta d-block text-decoration-none h-100">
                <div class="app-tarjeta-cuerpo"><span class="app-ayuda d-block">Nóminas por aprobar</span><span class="fs-3 fw-bold" style="color: var(--text-primary);">@Model.NominasPorAprobar.Count</span></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-controller="Incidencias" asp-action="Index" asp-route-estado="Pendiente" class="app-tarjeta d-block text-decoration-none h-100">
                <div class="app-tarjeta-cuerpo"><span class="app-ayuda d-block">Solicitudes por aprobar</span><span class="fs-3 fw-bold" style="color: var(--text-primary);">@Model.IncidenciasPorAprobar</span></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-controller="Liquidaciones" asp-action="Index" class="app-tarjeta d-block text-decoration-none h-100">
                <div class="app-tarjeta-cuerpo"><span class="app-ayuda d-block">Liquidaciones en borrador</span><span class="fs-3 fw-bold" style="color: var(--text-primary);">@Model.LiquidacionesBorrador</span></div>
            </a>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-7">
            <div class="app-tarjeta h-100">
                <div class="app-tarjeta-titulo"><i class="bi bi-hourglass-split"></i> Nóminas por aprobar</div>
                <div class="app-tarjeta-cuerpo">
                    @if (!Model.NominasPorAprobar.Any())
                    {
                        <div class="app-ayuda">No hay nóminas calculadas esperando aprobación.</div>
                    }
                    <ul class="app-historial">
                        @foreach (var n in Model.NominasPorAprobar)
                        {
                            <li>
                                <span class="fecha">@n.FechaCalculo?.ToString("dd/MM HH:mm")</span>
                                <span><a asp-controller="Nominas" asp-action="Detalle" asp-route-id="@n.Id">@n.Descripcion</a> · neto RD$ @n.TotalNeto.ToString("N2") · @n.Recibos.Count recibo(s)</span>
                            </li>
                        }
                    </ul>
                    @if (Model.UltimaPagada != null)
                    {
                        <hr />
                        <span class="app-ayuda d-block">Última nómina pagada</span>
                        <a asp-controller="Nominas" asp-action="Detalle" asp-route-id="@Model.UltimaPagada.Id" class="fw-semibold">@Model.UltimaPagada.Descripcion</a>
                        <span> · pagada el @Model.UltimaPagada.FechaPago?.ToString("dd/MM/yyyy") · neto RD$ @Model.UltimaPagada.TotalNeto.ToString("N2") · costo total RD$ @((Model.UltimaPagada.TotalIngresos + Model.UltimaPagada.TotalAportesPatronales).ToString("N2"))</span>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="app-tarjeta h-100">
                <div class="app-tarjeta-titulo"><i class="bi bi-calendar-event"></i> Próximos feriados</div>
                <div class="app-tarjeta-cuerpo">
                    @if (!Model.ProximosFeriados.Any())
                    {
                        <div class="app-ayuda">No hay feriados registrados. Genérelos en Parámetros legales.</div>
                    }
                    <ul class="app-historial">
                        @foreach (var f in Model.ProximosFeriados)
                        {
                            <li><span class="fecha">@f.Fecha.ToString("ddd dd/MM")</span><span>@f.Nombre</span></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
