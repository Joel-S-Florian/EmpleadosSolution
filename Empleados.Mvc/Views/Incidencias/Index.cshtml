@model List<Incidencia>
@{
    ViewData["Title"] = "Incidencias y vacaciones";
    var nuevo = (IncidenciaDto)ViewBag.Nuevo;
    var desde = (DateTime)ViewBag.Desde;
    var estado = (EstadoIncidencia?)ViewBag.Estado;
    var volver = Context.Request.Path + Context.Request.QueryString;
}

<div class="app-pagina">
    <div class="app-encabezado">
        <div class="d-flex gap-3 align-items-start">
            <span class="app-icono"><i class="bi bi-calendar2-check"></i></span>
            <div>
                <h1>Incidencias y vacaciones</h1>
                <p>Faltas, retardos y permisos sin goce aprobados se descuentan solos en la nómina del período.</p>
            </div>
        </div>
    </div>

    <partial name="~/Views/Shared/Components/_Alertas.cshtml" />

    <form asp-action="Crear" method="post" class="app-tarjeta">
        <div class="app-tarjeta-titulo"><i class="bi bi-plus-circle"></i> Registrar incidencia</div>
        <div class="app-tarjeta-cuerpo">
            <div asp-validation-summary="All" class="app-resumen-error"></div>
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label for="EmpleadoId" class="app-etiqueta">Empleado</label>
                    <select id="EmpleadoId" name="EmpleadoId" asp-items="ViewBag.Empleados" class="form-select" required>
                        <option value="">Seleccione…</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label for="Tipo" class="app-etiqueta">Tipo</label>
                    <select id="Tipo" name="Tipo" asp-items="Html.GetEnumSelectList<TipoIncidencia>().Select(i => { i.Selected = i.Value == ((int)nuevo.Tipo).ToString(); return i; })" class="form-select"></select>
                </div>
                <div class="col-md-2">
                    <label for="FechaInicio" class="app-etiqueta">Desde</label>
                    <input id="FechaInicio" name="FechaInicio" type="date" value="@nuevo.FechaInicio.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label for="FechaFin" class="app-etiqueta">Hasta</label>
                    <input id="FechaFin" name="FechaFin" type="date" value="@nuevo.FechaFin.ToString("yyyy-MM-dd")" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label for="Dias" class="app-etiqueta">Días</label>
                    <input id="Dias" name="Dias" type="number" step="0.5" min="0.5" value="@nuevo.Dias" class="form-control" placeholder="Automático" title="Vacío: días laborables (lunes a viernes, sin feriados)" />
                </div>
                <div class="col-md-2">
                    <label for="Horas" class="app-etiqueta">Horas (retardo)</label>
                    <input id="Horas" name="Horas" type="number" step="0.25" min="0" max="24" value="@nuevo.Horas.ToString("0.##")" class="form-control" />
                </div>
                <div class="col-md-2">
                    <label for="Descontar" class="app-etiqueta">Descontar del salario</label>
                    <select id="Descontar" name="Descontar" class="form-select">
                        <option value="" selected="@(nuevo.Descontar == null)">Según el tipo</option>
                        <option value="true" selected="@(nuevo.Descontar == true)">Sí</option>
                        <option value="false" selected="@(nuevo.Descontar == false)">No</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <label for="Comentario" class="app-etiqueta">Comentario</label>
                    <input id="Comentario" name="Comentario" value="@nuevo.Comentario" class="form-control" maxlength="500" placeholder="Certificado médico, motivo del permiso…" />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="app-boton w-100 justify-content-center"><i class="bi bi-plus-lg"></i> Registrar</button>
                </div>
            </div>
            <div class="app-ayuda mt-2">Por defecto se descuentan faltas, retardos y permisos sin goce. Las vacaciones se validan contra el saldo del año de servicio.</div>
        </div>
    </form>

    <form asp-action="Colectivas" method="post" class="app-tarjeta">
        <div class="app-tarjeta-titulo"><i class="bi bi-people"></i> Vacaciones colectivas <small>se registran aprobadas; se omite a quien no tenga saldo</small></div>
        <div class="app-tarjeta-cuerpo">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label for="colDepartamento" class="app-etiqueta">Departamento</label>
                    <select id="colDepartamento" name="DepartamentoId" asp-items="ViewBag.Departamentos" class="form-select">
                        <option value="">Toda la empresa</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label for="colDesde" class="app-etiqueta">Desde</label>
                    <input id="colDesde" name="FechaInicio" type="date" class="form-control" required />
                </div>
                <div class="col-md-2">
                    <label for="colHasta" class="app-etiqueta">Hasta</label>
                    <input id="colHasta" name="FechaFin" type="date" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label for="colComentario" class="app-etiqueta">Comentario</label>
                    <input id="colComentario" name="Comentario" class="form-control" maxlength="500" placeholder="Vacaciones colectivas" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="app-boton-sec w-100 justify-content-center" onclick="return confirm('¿Registrar estas vacaciones a todos los empleados seleccionados?')"><i class="bi bi-calendar-plus"></i> Registrar</button>
                </div>
            </div>
        </div>
    </form>

    <div class="app-tarjeta">
        <form method="get" class="app-tarjeta-cuerpo row g-2 align-items-end">
            <div class="col-md-3">
                <label for="filtroMes" class="app-etiqueta">Mes</label>
                <input id="filtroMes" type="month" value="@desde.ToString("yyyy-MM")" class="form-control"
                       onchange="var p=this.value.split('-'); this.form.anio.value=p[0]; this.form.mes.value=p[1];" />
                <input type="hidden" name="anio" value="@desde.Year" />
                <input type="hidden" name="mes" value="@desde.Month" />
            </div>
            <div class="col-md-3">
                <label for="filtroEstado" class="app-etiqueta">Estado</label>
                <select id="filtroEstado" name="estado" class="form-select">
                    <option value="">Todos</option>
                    @foreach (var e in Enum.GetValues<EstadoIncidencia>())
                    {
                        <option value="@e" selected="@(estado == e)">@e.Texto()</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label for="filtroEmpleado" class="app-etiqueta">Empleado</label>
                <select id="filtroEmpleado" name="empleadoId" asp-items="ViewBag.FiltroEmpleados" class="form-select">
                    <option value="">Todos</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="app-boton-sec w-100 justify-content-center"><i class="bi bi-funnel"></i> Filtrar</button>
            </div>
        </form>
        <div class="table-responsive">
            <table class="table table-hover app-tabla">
                <thead>
                    <tr><th>Empleado</th><th>Tipo</th><th>Fechas</th><th class="app-numero">Días / horas</th><th>Descuenta</th><th>Estado</th><th></th></tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="app-ayuda">No hay incidencias en @desde.ToString("MMMM yyyy").</td></tr>
                    }
                    @foreach (var i in Model)
                    {
                        <tr>
                            <td><a asp-controller="Empleados" asp-action="Details" asp-route-id="@i.EmpleadoId">@i.Empleado?.Nombre @i.Empleado?.Apellido</a></td>
                            <td>
                                @i.Tipo.Texto()
                                @if (i.Comentario != null) { <span class="app-ayuda d-block">@i.Comentario</span> }
                            </td>
                            <td>@i.FechaInicio.ToString("dd/MM/yyyy")@(i.FechaFin > i.FechaInicio ? " – " + i.FechaFin.ToString("dd/MM/yyyy") : "")</td>
                            <td class="app-numero">@(i.Tipo == TipoIncidencia.Retardo ? i.Horas.ToString("0.##") + " h" : i.Dias.ToString("0.##"))</td>
                            <td>@(i.Descontar ? "Sí" : "No")</td>
                            <td>
                                <span class="app-chip">@i.Estado.Texto()</span>
                                @if (i.MotivoRechazo != null) { <span class="app-ayuda d-block">@i.MotivoRechazo</span> }
                                @if (i.RevisadaPor != null) { <span class="app-ayuda d-block">por @i.RevisadaPor</span> }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (i.Estado == EstadoIncidencia.Pendiente)
                                {
                                    <form asp-action="Aprobar" asp-route-id="@i.Id" method="post" class="d-inline">
                                        <input type="hidden" name="volver" value="@volver" />
                                        <button type="submit" class="app-boton py-1 px-2">Aprobar</button>
                                    </form>
                                    <form asp-action="Rechazar" asp-route-id="@i.Id" method="post" class="d-inline"
                                          onsubmit="var m=prompt('Motivo del rechazo (opcional)'); if(m===null) return false; this.motivo.value=m;">
                                        <input type="hidden" name="volver" value="@volver" />
                                        <input type="hidden" name="motivo" />
                                        <button type="submit" class="app-boton-sec py-1 px-2">Rechazar</button>
                                    </form>
                                }
                                <form asp-action="Eliminar" asp-route-id="@i.Id" method="post" class="d-inline">
                                    <input type="hidden" name="volver" value="@volver" />
                                    <button type="submit" class="app-boton-peligro" title="Eliminar" aria-label="Eliminar" onclick="return confirm('¿Eliminar esta incidencia?')"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
