@model NominaPeriodo
@using Empleados.Data.Services
@{
    ViewData["Title"] = "Nómina " + Model.Descripcion;
    var anteriores = (Dictionary<int, decimal>)ViewBag.NetosAnteriores;
    var esAdmin = User.IsInRole("Admin");
    var conErrores = Model.Recibos.Count(r => r.ErroresJson != null);
}

<div class="app-pagina">
    <div class="app-encabezado">
        <div class="d-flex gap-3 align-items-start">
            <a asp-action="Index" class="app-icono" aria-label="Volver"><i class="bi bi-arrow-left"></i></a>
            <div>
                <h1>Nómina @Model.Descripcion <partial name="_EstadoNomina" model="Model.Estado" /></h1>
                <p>
                    Del @Model.FechaInicio.ToString("dd/MM/yyyy") al @Model.FechaFin.ToString("dd/MM/yyyy")
                    · creada por @(Model.CreadaPor ?? "—")
                    @if (Model.FechaCalculo.HasValue) { <span>· calculada @Model.FechaCalculo.Value.ToString("dd/MM HH:mm")</span> }
                    @if (Model.AprobadaPor != null) { <span>· aprobada por @Model.AprobadaPor</span> }
                    @if (Model.FechaPago.HasValue) { <span>· pagada el @Model.FechaPago.Value.ToString("dd/MM/yyyy")</span> }
                </p>
            </div>
        </div>
        <div class="d-flex gap-2 flex-wrap align-items-end">
            <a asp-action="ResumenPdf" asp-route-id="@Model.Id" class="app-boton-sec" title="Una fila por empleado, con totales"><i class="bi bi-table"></i> Resumen PDF</a>
            <a asp-action="RecibosPdf" asp-route-id="@Model.Id" class="app-boton-sec" title="Un recibo detallado por página"><i class="bi bi-file-earmark-pdf"></i> Todos los recibos</a>
            @if (Model.Editable)
            {
                <form asp-action="Calcular" asp-route-id="@Model.Id" method="post"><button type="submit" class="app-boton-sec"><i class="bi bi-arrow-repeat"></i> Recalcular</button></form>
                <form asp-action="Eliminar" asp-route-id="@Model.Id" method="post"><button type="submit" class="app-boton-sec" onclick="return confirm('¿Eliminar esta nómina y sus novedades?')"><i class="bi bi-trash"></i> Eliminar</button></form>
            }
            @if (esAdmin && Model.Estado == EstadoNomina.Calculada)
            {
                <form asp-action="Aprobar" asp-route-id="@Model.Id" method="post"><button type="submit" class="app-boton" disabled="@(conErrores > 0)" title="@(conErrores > 0 ? "Corrija los recibos con errores" : "")"><i class="bi bi-check2-circle"></i> Aprobar</button></form>
            }
            @if (esAdmin && Model.Estado == EstadoNomina.Aprobada)
            {
                <form asp-action="Reabrir" asp-route-id="@Model.Id" method="post"><button type="submit" class="app-boton-sec"><i class="bi bi-unlock"></i> Reabrir</button></form>
                <form asp-action="Pagar" asp-route-id="@Model.Id" method="post" class="d-flex gap-1 align-items-end">
                    <div>
                        <label for="fechaPago" class="app-etiqueta">Fecha de pago</label>
                        <input id="fechaPago" name="fechaPago" type="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" required />
                    </div>
                    <button type="submit" class="app-boton" onclick="return confirm('Al marcarla como pagada ya no se podrá modificar y se descontarán las cuotas de los préstamos. ¿Continuar?')"><i class="bi bi-cash-coin"></i> Marcar pagada</button>
                </form>
            }
            @if (Model.Estado is EstadoNomina.Pagada or EstadoNomina.Cerrada)
            {
                <form asp-action="EnviarRecibos" asp-route-id="@Model.Id" method="post"><button type="submit" class="app-boton-sec" onclick="return confirm('¿Enviar de nuevo los recibos por correo a todos los empleados?')"><i class="bi bi-envelope"></i> Enviar recibos por correo</button></form>
            }
            @if (esAdmin && Model.Estado == EstadoNomina.Pagada)
            {
                <form asp-action="Cerrar" asp-route-id="@Model.Id" method="post"><button type="submit" class="app-boton"><i class="bi bi-lock"></i> Cerrar período</button></form>
            }
        </div>
    </div>

    <partial name="~/Views/Shared/Components/_Alertas.cshtml" />
    @if (conErrores > 0)
    {
        <div class="app-alerta-error"><i class="bi bi-exclamation-octagon"></i> @conErrores recibo(s) con errores. Corrija los datos del empleado y presione Recalcular antes de aprobar.</div>
    }

    <div class="row g-3 mb-3">
        @foreach (var (titulo, monto) in new[] { ("Ingresos", Model.TotalIngresos), ("Deducciones", Model.TotalDeducciones), ("Neto a pagar", Model.TotalNeto), ("Aportes del empleador", Model.TotalAportesPatronales), ("Costo total", Model.TotalIngresos + Model.TotalAportesPatronales) })
        {
            <div class="col">
                <div class="app-tarjeta mb-0 h-100">
                    <div class="app-tarjeta-cuerpo">
                        <div class="app-ayuda">@titulo</div>
                        <div class="fw-bold" style="font-size:1.15rem;">RD$ @monto.ToString("N2")</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="app-tarjeta">
        <div class="app-tarjeta-titulo"><i class="bi bi-people"></i> Recibos (@Model.Recibos.Count)</div>
        <div class="table-responsive">
            <table class="table table-hover app-tabla">
                <thead>
                    <tr>
                        <th>Empleado</th>
                        <th>Novedades</th>
                        <th class="app-numero">Ingresos</th>
                        <th class="app-numero">Deducciones</th>
                        <th class="app-numero">Neto</th>
                        <th class="app-numero">Δ vs anterior</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Recibos.OrderBy(r => r.NombreEmpleado))
                    {
                        var errores = CicloNominaService.Lista(r.ErroresJson);
                        var avisos = CicloNominaService.Lista(r.AdvertenciasJson);
                        var novedades = new List<string>();
                        if (r.HorasExtra + r.HorasExtraExceso > 0) { novedades.Add($"{r.HorasExtra + r.HorasExtraExceso:0.#} h extra"); }
                        if (r.DiasAusenciaSinPago > 0) { novedades.Add($"{r.DiasAusenciaSinPago:0.#} d ausencia"); }
                        if (r.Novedades.Count > 0) { novedades.Add($"{r.Novedades.Count} ingreso(s)/descuento(s)"); }
                        if (r.Lineas.Any(l => l.PrestamoId != null)) { novedades.Add("préstamo"); }
                        <tr>
                            <td>
                                <div class="fw-semibold">@r.NombreEmpleado</div>
                                <div class="app-ayuda">@(r.Documento ?? "sin documento") · @(r.Departamento ?? "—")</div>
                                @foreach (var e in errores) { <div class="app-error"><i class="bi bi-x-octagon"></i> @e</div> }
                                @foreach (var a in avisos) { <div class="app-ayuda"><i class="bi bi-exclamation-triangle"></i> @a</div> }
                            </td>
                            <td class="app-ayuda">@(novedades.Any() ? string.Join(" · ", novedades) : "—")</td>
                            <td class="app-numero">@r.TotalIngresos.ToString("N2")</td>
                            <td class="app-numero">@((r.TotalDeduccionesLey + r.TotalDeduccionesInternas).ToString("N2"))</td>
                            <td class="app-numero fw-semibold">@r.Neto.ToString("N2")</td>
                            <td class="app-numero">
                                @if (anteriores.TryGetValue(r.EmpleadoId, out var anterior))
                                {
                                    var diferencia = r.Neto - anterior;
                                    <span style="color:@(diferencia == 0 ? "var(--text-muted)" : "var(--text-primary)");">@(diferencia > 0 ? "+" : "")@diferencia.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="app-ayuda">nuevo</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                @if (Model.Editable && Model.Tipo == TipoNomina.Regular)
                                {
                                    <a asp-action="Novedades" asp-route-id="@r.Id" class="app-boton-sec py-1 px-2" title="Novedades"><i class="bi bi-pencil-square"></i></a>
                                }
                                <a asp-action="Recibo" asp-route-id="@r.Id" class="app-boton-sec py-1 px-2" title="Ver recibo"><i class="bi bi-eye"></i></a>
                                <a asp-action="ReciboPdf" asp-route-id="@r.Id" class="app-boton-sec py-1 px-2" title="PDF"><i class="bi bi-file-earmark-pdf"></i></a>
                                @if (errores.Any())
                                {
                                    <a asp-controller="Empleados" asp-action="Edit" asp-route-id="@r.EmpleadoId" class="app-boton-sec py-1 px-2" title="Corregir datos del empleado"><i class="bi bi-person-gear"></i></a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @{ var envios = (List<EnvioCorreo>)ViewBag.Envios; }
    @if (envios.Any())
    {
        var ultimos = envios.GroupBy(e => e.ReciboId).Select(g => g.First()).ToList();
        <div class="app-tarjeta">
            <div class="app-tarjeta-titulo"><i class="bi bi-envelope"></i> Recibos por correo <small>@ultimos.Count(e => e.Estado == EstadoEnvio.Enviado) enviado(s) · @ultimos.Count(e => e.Estado == EstadoEnvio.Fallido) fallido(s) · último envío @envios.Max(e => e.Fecha).ToString("dd/MM/yyyy HH:mm")</small></div>
            @if (ultimos.Any(e => e.Estado == EstadoEnvio.Fallido))
            {
                <ul class="app-tarjeta-cuerpo mb-0">
                    @foreach (var e in ultimos.Where(e => e.Estado == EstadoEnvio.Fallido))
                    {
                        <li>@e.Destino: @e.Error</li>
                    }
                </ul>
            }
        </div>
    }
</div>
