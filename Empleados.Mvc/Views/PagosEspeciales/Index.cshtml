@using Empleados.Data.Services
@model RepartoBonificacion?
@{
    ViewData["Title"] = "Pagos especiales";
    var navidad = (List<NominaPeriodo>)ViewBag.Navidad;
    var anioFiscal = (int)ViewBag.AnioFiscal;
    var utilidad = (decimal?)ViewBag.Utilidad;
}

<div class="app-pagina">
    <div class="app-encabezado">
        <div class="d-flex gap-3 align-items-start">
            <span class="app-icono"><i class="bi bi-gift"></i></span>
            <div>
                <h1>Pagos especiales</h1>
                <p>Salario de Navidad y participación en los beneficios de la empresa.</p>
            </div>
        </div>
    </div>

    <partial name="~/Views/Shared/Components/_Alertas.cshtml" />

    <div class="app-tarjeta">
        <div class="app-tarjeta-titulo"><i class="bi bi-snow"></i> Salario de Navidad (art. 219) <small>1/12 del salario ordinario del año; sin TSS ni ISR; se paga antes del 20 de diciembre</small></div>
        <div class="app-tarjeta-cuerpo">
            <form asp-action="CrearSalarioNavidad" method="post" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label for="anio" class="app-etiqueta">Año</label>
                    <input id="anio" name="anio" type="number" min="2020" max="2100" value="@DateTime.Today.Year" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="app-boton w-100 justify-content-center"><i class="bi bi-calculator"></i> Crear y calcular</button>
                </div>
            </form>
            <div class="app-ayuda mt-2">Usa lo registrado en las nóminas del año (salario menos ausencias) y estima los meses sin nómina con el salario actual. Se aprueba y se paga como cualquier nómina.</div>
            @if (navidad.Any())
            {
                <ul class="app-historial mt-3">
                    @foreach (var n in navidad)
                    {
                        <li>
                            <span class="fecha">@n.Anio</span>
                            <span><a asp-controller="Nominas" asp-action="Detalle" asp-route-id="@n.Id">@n.Descripcion</a> · @n.TotalNeto.ToString("N2") · <partial name="~/Views/Nominas/_EstadoNomina.cshtml" model="n.Estado" /></span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>

    <div class="app-tarjeta">
        <div class="app-tarjeta-titulo"><i class="bi bi-graph-up-arrow"></i> Bonificación (art. 223) <small>10 % de la utilidad neta, con tope de 45 días de salario (menos de 3 años) o 60 días (3 años o más)</small></div>
        <div class="app-tarjeta-cuerpo">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label for="anioFiscal" class="app-etiqueta">Ejercicio fiscal</label>
                    <input id="anioFiscal" name="anioFiscal" type="number" min="2020" max="2100" value="@anioFiscal" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <label for="utilidad" class="app-etiqueta">Utilidad neta (RD$)</label>
                    <input id="utilidad" name="utilidad" type="number" step="0.01" min="0.01" value="@utilidad?.ToString("0.00")" class="form-control" required />
                </div>
                <div class="col-md-3">
                    <button type="submit" class="app-boton-sec w-100 justify-content-center"><i class="bi bi-eye"></i> Ver reparto</button>
                </div>
            </form>
            <div class="app-ayuda mt-2">Se paga entre 90 y 120 días después del cierre fiscal. Se carga como ingreso en una nómina regular (grava ISR, no cotiza TSS) con la retención del 0.5 % para el INFOTEP.</div>
        </div>

        @if (Model != null)
        {
            <div class="table-responsive">
                <table class="table table-hover app-tabla">
                    <thead>
                        <tr><th>Empleado</th><th>Pago</th><th class="app-numero">Tiempo</th><th class="app-numero">Proporcional</th><th class="app-numero">Tope</th><th class="app-numero">Bonificación</th><th class="app-numero">INFOTEP</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Partes)
                        {
                            <tr>
                                <td>@p.Nombre</td>
                                <td>@p.Frecuencia.Texto()</td>
                                <td class="app-numero">@((p.Parte.FactorTiempo * 100).ToString("0.#")) %</td>
                                <td class="app-numero">@p.Parte.Proporcional.ToString("N2")</td>
                                <td class="app-numero">@p.Parte.Tope.ToString("N2") <span class="app-ayuda">(@p.Parte.DiasTope días)</span></td>
                                <td class="app-numero fw-semibold">@p.Parte.Monto.ToString("N2")</td>
                                <td class="app-numero">@p.Infotep.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fw-semibold">
                            <td colspan="5">Ejercicio @Model.Inicio.ToString("dd/MM/yyyy") – @Model.Cierre.ToString("dd/MM/yyyy") · a repartir @Model.ARepartir.ToString("N2")</td>
                            <td class="app-numero">@Model.TotalBonificacion.ToString("N2")</td>
                            <td class="app-numero">@Model.Partes.Sum(p => p.Infotep).ToString("N2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
            <form asp-action="AplicarBonificacion" method="post" class="app-tarjeta-cuerpo row g-2 align-items-end">
                <input type="hidden" name="anioFiscal" value="@Model.AnioFiscal" />
                <input type="hidden" name="utilidad" value="@Model.UtilidadNeta.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
                <div class="col-md-4">
                    <label for="nominaId" class="app-etiqueta">Pagar en la nómina</label>
                    <select data-smart-select id="nominaId" name="nominaId" asp-items="ViewBag.NominasDestino" class="form-select" required>
                        <option value="">Seleccione una nómina sin aprobar…</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="app-boton w-100 justify-content-center"><i class="bi bi-check-lg"></i> Aplicar</button>
                </div>
                <div class="col-12 app-ayuda">Se aplica a los empleados de esa nómina; si hay empleados quincenales y mensuales, aplíquela también en la otra.</div>
            </form>
        }
    </div>
</div>
