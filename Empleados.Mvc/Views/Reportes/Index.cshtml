@using Empleados.Data.Services
@model TablaReporte
@{
    ViewData["Title"] = "Reportes";
    var tipo = (TipoReporte)ViewBag.Tipo;
    var filtro = (FiltroReporte)ViewBag.Filtro;
    var info = GeneradorReportes.Catalogo[tipo];
    var ruta = new Dictionary<string, string?>
    {
        ["tipo"] = tipo.ToString(),
        ["anio"] = filtro.Anio.ToString(),
        ["mes"] = filtro.Mes?.ToString(),
        ["departamentoId"] = filtro.DepartamentoId?.ToString(),
        ["estado"] = filtro.Estado?.ToString(),
        ["nominaId"] = filtro.NominaId?.ToString()
    };
    var hayFiltros = info.Anio || info.Mes || info.Departamento || info.Estado || info.Nomina;
}

<div class="app-pagina">
    <div class="app-encabezado">
        <div class="d-flex gap-3 align-items-start">
            <span class="app-icono"><i class="bi bi-bar-chart-line"></i></span>
            <div>
                <h1>Reportes</h1>
                <p>Personal, nómina y asistencia. Elija un reporte, ajuste los filtros y descárguelo en Excel, CSV o PDF.</p>
            </div>
        </div>
    </div>

    <div class="app-reportes">
        <nav class="app-reportes-catalogo" aria-label="Reportes disponibles">
            @foreach (var grupo in GeneradorReportes.Catalogo.GroupBy(r => r.Value.Categoria))
            {
                <div class="app-reportes-grupo">@grupo.Key</div>
                @foreach (var r in grupo)
                {
                    <a asp-action="Index" asp-route-tipo="@r.Key" asp-route-anio="@filtro.Anio" class="@(r.Key == tipo ? "activo" : "")" aria-current="@(r.Key == tipo ? "page" : null)">
                        <i class="bi @r.Value.Icono"></i> @Textos.De(r.Key)
                    </a>
                }
            }
        </nav>

        <div class="app-reportes-contenido">
            <div class="app-tarjeta">
                <div class="app-tarjeta-titulo">
                    <i class="bi @info.Icono"></i> @Textos.De(tipo)
                    <small>@info.Descripcion</small>
                </div>
                @if (hayFiltros)
                {
                    <form method="get" class="app-tarjeta-cuerpo row g-2 align-items-end border-bottom">
                        <input type="hidden" name="tipo" value="@tipo" />
                        @if (info.Nomina)
                        {
                            <div class="col-12 col-xl-6">
                                <label for="nominaId" class="app-etiqueta">Nómina</label>
                                <select id="nominaId" name="nominaId" asp-items="ViewBag.Nominas" class="form-select"></select>
                            </div>
                        }
                        @if (info.Anio)
                        {
                            <div class="col-6 col-lg-4 col-xl-2">
                                <label for="anio" class="app-etiqueta">Año</label>
                                <input id="anio" name="anio" type="number" min="2020" max="2100" value="@filtro.Anio" class="form-control" />
                            </div>
                        }
                        @if (info.Mes)
                        {
                            <div class="col-6 col-lg-4 col-xl-3">
                                <label for="mes" class="app-etiqueta">Mes</label>
                                <select id="mes" name="mes" class="form-select">
                                    <option value="">@(tipo == TipoReporte.Cumpleanos ? "Este mes" : "Todo el año")</option>
                                    @for (var m = 1; m <= 12; m++)
                                    {
                                        <option value="@m" selected="@(m == filtro.Mes)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
                                    }
                                </select>
                            </div>
                        }
                        @if (info.Departamento)
                        {
                            <div class="col-12 col-lg-4 col-xl-4">
                                <label for="departamentoId" class="app-etiqueta">Departamento</label>
                                <select id="departamentoId" name="departamentoId" asp-items="ViewBag.Departamentos" class="form-select">
                                    <option value="">Todos</option>
                                </select>
                            </div>
                        }
                        @if (info.Estado)
                        {
                            <div class="col-6 col-lg-4 col-xl-3">
                                <label for="estado" class="app-etiqueta">Estado</label>
                                <select id="estado" name="estado" class="form-select">
                                    <option value="">Activos e inactivos</option>
                                    @foreach (var e in Enum.GetValues<EstadoEmpleado>())
                                    {
                                        <option value="@e" selected="@(e == filtro.Estado)">@e.Texto()</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="col-md-auto">
                            <button type="submit" class="app-boton"><i class="bi bi-funnel"></i> Aplicar</button>
                        </div>
                    </form>
                }
                <div class="app-tarjeta-cuerpo d-flex flex-wrap align-items-center gap-2">
                    <span class="app-ayuda me-auto">@Model.Subtitulo · @Model.Filas.Count fila(s)</span>
                    <a asp-action="Index" asp-all-route-data="ruta" asp-route-formato="xlsx" class="app-boton-sec"><i class="bi bi-file-earmark-excel"></i> Excel</a>
                    <a asp-action="Index" asp-all-route-data="ruta" asp-route-formato="csv" class="app-boton-sec"><i class="bi bi-filetype-csv"></i> CSV</a>
                    <a asp-action="Index" asp-all-route-data="ruta" asp-route-formato="pdf" class="app-boton-sec"><i class="bi bi-file-earmark-pdf"></i> PDF</a>
                </div>
            </div>

            <div class="app-tarjeta">
                <div class="app-tarjeta-titulo">@Model.Titulo</div>
                <div class="table-responsive">
                    <table class="table table-hover app-tabla mb-0">
                        <thead>
                            <tr>
                                @foreach (var c in Model.Columnas)
                                {
                                    <th class="@(c.Numerica ? "app-numero" : "")">@c.Titulo</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Filas.Any())
                            {
                                <tr><td colspan="@Model.Columnas.Count" class="app-ayuda">Sin datos para estos filtros@(info.Categoria == GeneradorReportes.Nominas ? " (los reportes de nómina usan solo las nóminas aprobadas)" : "").</td></tr>
                            }
                            @foreach (var fila in Model.Filas)
                            {
                                <tr>
                                    @for (var i = 0; i < fila.Length; i++)
                                    {
                                        <td class="@(fila[i] is decimal ? "app-numero" : "")">@GeneradorReportes.Celda(fila[i], Model.Columnas[i])</td>
                                    }
                                </tr>
                            }
                        </tbody>
                        @if (Model.Totales is { } totales)
                        {
                            <tfoot>
                                <tr class="fw-semibold">
                                    @for (var i = 0; i < totales.Length; i++)
                                    {
                                        <td class="@(totales[i] is decimal ? "app-numero" : "")">@GeneradorReportes.Celda(totales[i], Model.Columnas[i])</td>
                                    }
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </div>

            @if (info.Categoria == GeneradorReportes.Nominas)
            {
                <p class="app-ayuda">El resumen de aportes a la TSS y del ISR del mes está en <a asp-controller="Archivos" asp-action="Index">Archivos TSS y banco</a>.</p>
            }
        </div>
    </div>
</div>
