@model (string Icon, string Label, string Value, string Subtext, string Color)
@{
    var accent = Model.Color == "success" ? "var(--success)" : Model.Color == "warning" ? "var(--warning)" : Model.Color == "accent" ? "var(--accent)" : "var(--text-primary)";
    var soft = Model.Color == "success" ? "var(--success-soft)" : Model.Color == "warning" ? "var(--warning-soft)" : Model.Color == "accent" ? "var(--accent-soft)" : "var(--bg-muted)";
}
<div style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: var(--radius); padding: var(--space-lg); box-shadow: var(--shadow-sm); display:flex; flex-direction:column; gap: var(--space-sm);">
    <div style="display:flex; align-items:center; justify-content:space-between;">
        <span style="font-size:0.75rem; letter-spacing:0.06em; text-transform:uppercase; color: var(--text-muted); font-weight:600;">@Model.Label</span>
        <span style="width:36px; height:36px; display:grid; place-items:center; border-radius: var(--radius); background: @soft; color: @accent;"><i class="bi @Model.Icon"></i></span>
    </div>
    <div style="font-size:1.6rem; font-weight:700; color: var(--text-primary); letter-spacing:-0.03em; line-height:1;">@Model.Value</div>
    @if (!string.IsNullOrEmpty(Model.Subtext))
    {
        <div style="font-size:0.8rem; color: var(--text-secondary);">@Model.Subtext</div>
    }
</div>
