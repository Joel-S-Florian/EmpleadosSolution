@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Empleados</title>
    <meta name="description" content="Nómina y Recursos Humanos para República Dominicana: TSS, ISR, Salario de Navidad, vacaciones, liquidaciones y portal del empleado." />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Sans:wght@500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/design-tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/publico.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
</head>
<body class="pub-body">
    <header class="pub-header">
        <div class="pub-header-interior">
            <a class="pub-marca" href="/">
                <span class="pub-marca-icono"><i class="bi bi-layers"></i></span>
                Empleados
            </a>
            <nav class="pub-nav" aria-label="Secciones">
                <a href="/#funciones">Funciones</a>
                <a href="/#como-funciona">Cómo funciona</a>
                <a href="/#cumplimiento">Cumplimiento</a>
            </nav>
            <div class="pub-acciones">
                <button class="pub-icono-btn" id="theme-toggle" type="button" aria-label="Cambiar tema" title="Cambiar tema">
                    <i class="bi bi-sun" data-theme-icon="sun"></i>
                    <i class="bi bi-moon d-none" data-theme-icon="moon"></i>
                    <span class="visually-hidden" id="theme-toggle-label">Modo claro</span>
                </button>
                @if (SignInManager.IsSignedIn(User))
                {
                    <a class="pub-boton" href="/">Ir al sistema <i class="bi bi-arrow-right"></i></a>
                }
                else if (ViewData["Title"] as string != "Iniciar sesión")
                {
                    <a class="pub-boton" asp-area="Identity" asp-page="/Account/Login">Iniciar sesión</a>
                }
            </div>
        </div>
    </header>

    <main class="pub-main">
        @RenderBody()
    </main>

    <footer class="pub-footer">
        <div class="pub-footer-interior">
            <span>© 2026 Empleados · Nómina y RRHH para República Dominicana</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
